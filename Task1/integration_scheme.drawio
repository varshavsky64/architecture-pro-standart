1" parent="1" source="CONV" target="ABS"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="К5. REST API,&lt;br&gt;онлайн" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#d97706;fontColor=#9a5a00;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="CONV" target="SCOR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="К7. БД,&lt;br&gt;раз в сутки" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#d97706;fontColor=#9a5a00;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="CONV" target="SCOR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="К6. REST API,&lt;br&gt;онлайн" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#d97706;fontColor=#9a5a00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="SCOR" target="BKI"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="К7. данные клиентов и платежи по кредитам — из БД, раз в сутки" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#d97706;fontColor=#9a5a00;exitX=0.55;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ABS" target="SCOR"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="718" y="950" /><mxPoint x="1885" y="950" /></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="200" height="24" as="geometry" /></mxCell><mxCell id="c30" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="1042" width="34" height="22" as="geometry" /></mxCell><mxCell id="c31" value="Собственная разработка или сопровождение IT банка" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1037" width="380" height="32" as="geometry" /></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="34" height="22" as="geometry" /></mxCell><mxCell id="c33" value="Платформа или коробочное решение подрядчика" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1075" width="380" height="32" as="geometry" /></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1118" width="34" height="22" as="geometry" /></mxCell><mxCell id="c35" value="Внешняя система" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1113" width="380" height="32" as="geometry" /></mxCell><mxCell id="c36" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1156" width="34" height="22" as="geometry" /></mxCell><mxCell id="c37" value="Ручная работа (Excel)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1151" width="380" height="32" as="geometry" /></mxCell><mxCell id="c38" value="" style="html=1;fontSize=12;whiteSpace=wrap;shape=mxgraph.c4.person2;align=center;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1188" width="34" height="34" as="geometry" /></mxCell><mxCell id="c39" value="Участник процесса" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="1189" width="380" height="32" as="geometry" /></mxCell><mxCell id="c40" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1242" width="2" height="2" as="geometry" /></mxCell><mxCell id="c41" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="74" y="1242" width="2" height="2" as="geometry" /></mxCell><mxCell id="c42" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#1f58d0;fontColor=#1f58d0;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="Процесс открытия депозита, шаги Д1–Д10" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="1227" width="380" height="32" as="geometry" /></mxCell><mxCell id="c44" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1276" width="2" height="2" as="geometry" /></mxCell><mxCell id="c45" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="74" y="1276" width="2" height="2" as="geometry" /></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#d97706;fontColor=#9a5a00;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="Кредитный процесс, шаги К1–К8" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="1261" width="380" height="32" as="geometry" /></mxCell><mxCell id="c48" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1310" width="2" height="2" as="geometry" /></mxCell><mxCell id="c49" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="74" y="1310" width="2" height="2" as="geometry" /></mxCell><mxCell id="c50" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#808080;fontColor=#444444;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="Другие взаимодействия" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="1295" width="380" height="32" as="geometry" /></mxCell><mxCell id="c52" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1344" width="2" height="2" as="geometry" /></mxCell><mxCell id="c53" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="74" y="1344" width="2" height="2" as="geometry" /></mxCell><mxCell id="c54" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=14;strokeColor=#808080;fontColor=#444444;dashed=1;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="Пунктир — ручной обмен: звонок, визит, почта" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="1329" width="380" height="32" as="geometry" /></mxCell><mxCell id="c56" value="&lt;b&gt;Открытие депозита&lt;/b&gt;&lt;br&gt;Д1. Клиент звонит в кол-центр уточнить условия депозита.&lt;br&gt;Д2. Оператор заводит обращение в системе кол-центра.&lt;br&gt;Д3. Обращение передаётся в АБС.&lt;br&gt;Д4. Отдел кредитования ежедневно считает ставки в Excel и шлёт файл по почте в бэк-офис депозитов.&lt;br&gt;Д5. Менеджер бэк-офиса депозитов обрабатывает заявку в АБС и указывает ставку.&lt;br&gt;Д6. АБС отправляет клиенту СМС со ставкой через СМС-шлюз и телеком-оператора.&lt;br&gt;Д7. Клиент приходит в отделение — после звонка или без него.&lt;br&gt;Д8. Если заявки не было, сотрудник отделения запрашивает ставку у бэк-офиса письмом.&lt;br&gt;Д9. Спецставка: бэк-офис депозитов письмом запрашивает у отдела кредитования кредитный риск по клиенту (тот смотрит его в своём разделе АБС) и считает ставку в Excel.&lt;br&gt;Д10. Сотрудник отделения создаёт депозит в АБС, выдаёт документы и загружает подписанные." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1010" width="860" height="360" as="geometry" /></mxCell><mxCell id="c57" value="&lt;b&gt;Кредитный процесс&lt;/b&gt;&lt;br&gt;К1. Клиент приходит в отделение.&lt;br&gt;К2. Менеджер оформляет заявку на кредит в АБС.&lt;br&gt;К3. Раз в сутки заявки уходят из АБС в Кредитный конвейер через интеграцию по БД.&lt;br&gt;К4. Сотрудник отдела кредитования рассматривает заявку в конвейере.&lt;br&gt;К5. Конвейер вызывает систему скоринга по REST API.&lt;br&gt;К6. Скоринг онлайн запрашивает кредитную историю в БКИ.&lt;br&gt;К7. Данные клиентов и платежи по кредитам из АБС и номера платежей из конвейера попадают в скоринг из БД раз в сутки.&lt;br&gt;К8. Решение принимает сотрудник. Раз в сутки одобренные заявки уходят в АБС, она зачисляет кредит на счёт." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="1010" width="850" height="360" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
