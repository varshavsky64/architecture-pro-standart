whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1028" y="294" width="214" height="180" as="geometry" /></mxCell><mxCell id="c65" value="&lt;b&gt;Кредитный конвейер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Camunda BPM, Oracle · коробка подрядчика&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1274" y="398" width="464" height="56" as="geometry" /></mxCell><mxCell id="c66" value="&lt;b&gt;Система кредитного скоринга&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Python, Flask REST API, PostgreSQL&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1274" y="464" width="222" height="56" as="geometry" /></mxCell><mxCell id="c67" value="&lt;b&gt;Бюро кредитных историй&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;внешняя, REST API&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1274" y="530" width="222" height="50" as="geometry" /></mxCell><mxCell id="c68" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;React.js, Java Spring Boot, PostgreSQL · платформа подрядчика&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="522" y="609" width="226" height="66" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;внешняя&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="522" y="699" width="226" height="66" as="geometry" /></mxCell><mxCell id="c70" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;сопровождает IT-отдел&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="787" width="110" height="54" as="geometry" /></mxCell><mxCell id="c71" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;внешний&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="890" y="787" width="110" height="54" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PHP, React.js&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="853" width="110" height="172" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;ASP.NET MVC 4.5, MS SQL · платформа подрядчика&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="853" width="110" height="172" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="1061" width="200" height="24" as="geometry" /></mxCell><mxCell id="c75" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="1091" width="40" height="24" as="geometry" /></mxCell><mxCell id="c76" value="Собственная разработка или сопровождение IT банка" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="48" y="1087" width="340" height="32" as="geometry" /></mxCell><mxCell id="c77" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="1091" width="40" height="24" as="geometry" /></mxCell><mxCell id="c78" value="Платформа или коробочное решение подрядчика" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="488" y="1087" width="340" height="32" as="geometry" /></mxCell><mxCell id="c79" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1091" width="40" height="24" as="geometry" /></mxCell><mxCell id="c80" value="Внешняя система" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="928" y="1087" width="340" height="32" as="geometry" /></mxCell><mxCell id="c81" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="1091" width="40" height="24" as="geometry" /></mxCell><mxCell id="c82" value="Ручная работа" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1368" y="1087" width="340" height="32" as="geometry" /></mxCell><mxCell id="c83" value="Плашка системы растянута на подразделения и бизнес-возможности, где система используется. Наложение плашек значит, что системы пересекаются по бизнес-возможностям." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1131" width="1760" height="44" as="geometry" /></mxCell><mxCell id="c84" value="&lt;b&gt;Кредитный процесс.&lt;/b&gt; Менеджер отделения оформляет заявку в АБС → раз в сутки заявки уходят через БД в Кредитный конвейер → сотрудник отдела кредитования рассматривает заявку, конвейер вызывает скоринг (данные АБС и конвейера — раз в сутки, БКИ — онлайн) → решение принимает сотрудник → раз в сутки одобренные заявки уходят в АБС, она зачисляет кредит на счёт клиента." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1179" width="1760" height="44" as="geometry" /></mxCell><mxCell id="c85" value="&lt;b&gt;Онлайн-каналы.&lt;/b&gt; Отдельной возможности «онлайн-продажи» в карте нет, поэтому сайт и интернет-банк отнесены к digital-оповещениям клиентов. Депозит или кредит онлайн сейчас не оформить." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1227" width="1760" height="44" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
